{
  "name": "nestjs-outbox",
  "version": "0.1.0",
  "description": "Transactional outbox and idempotent consumers for NestJS, Postgres and Kafka-compatible brokers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparkYJO1/nestjs-outbox.git"
  },
  "homepage": "https://github.com/sparkYJO1/nestjs-outbox#readme",
  "bugs": {
    "url": "https://github.com/sparkYJO1/nestjs-outbox/issues"
  },
  "author": "John Yoon",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "nestjs",
    "outbox",
    "transactional-outbox",
    "kafka",
    "redpanda",
    "postgres",
    "idempotency",
    "exactly-once"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run --config vitest.integration.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "kafkajs": ">=2",
    "pg": ">=8"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
